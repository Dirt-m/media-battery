<?xml version="1.0" encoding="utf-8"?>
<!-- The sideload build's extras. Neither may ship on Play, which is why the flavors
     exist. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Asked for with a dialog rather than a settings list. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <service
            android:name=".service.MbAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
