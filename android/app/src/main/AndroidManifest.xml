<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- App discovery for the tracked apps picker: every launchable app, without
         QUERY_ALL_PACKAGES. The home query is separate because a launcher is what the fast
         path watches for as the leave hint, and it is not always a launchable app itself. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- Sync only, and only once the user has a code: the battery works offline and the
         server never sees anything but ciphertext. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Two jobs: it is the background activity launch exemption that lets the service put
         the block screen in front while nothing of ours is on screen (without it the start
         is refused and the cover never appears), and it draws the arrival pill, the one
         real window left. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Granted by the user in Settings, never at install. The app only ever reads it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".MediaBatteryApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.MediaBattery"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The cover. Its own task by its own affinity, so it can never pull the gauge or
             the settings page up with it, and finishing it never lands the user in this app.
             In recents on purpose: only a task gets a switcher card. singleTask so a second
             block reuses the one page rather than stacking covers. -->
        <activity
            android:name=".block.BlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.mediabattery.block" />

        <service
            android:name=".service.BatteryService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Times the user's own app usage against their self set media battery and covers chosen apps when it runs out" />
        </service>

        <!-- The door to the media sessions. It overrides connect and disconnect and nothing
             else, so it cannot read a notification even by accident. -->
        <service
            android:name=".media.MbNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The charge, one swipe away. Read only: tapping it opens the app. -->
        <service
            android:name=".tile.BatteryTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The charge on the home screen. Pushed by the service, never polled: its
             update period is zero and it owns no alarm. -->
        <receiver
            android:name=".widget.BatteryWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_info" />
        </receiver>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
